{#
| Variable                  | Type   | Description                                      |
|---------------------------|--------|--------------------------------------------------|
| component                 | object | Merchant-editable settings from twilight.json    |
| component.eyebrow         | string | Short editorial label                            |
| component.title           | string | Main campaign headline                           |
| component.description    | string | Supporting campaign copy                         |
| component.image           | string | Optional merchant-uploaded campaign image        |
| component.image_alt       | string | Accessible image description                     |
| component.cta_label       | string | Primary action label                             |
| component.cta_url         | string | Salla variable-list URL                          |
| componentId               | string | Twilight component identifier                    |
#}
{% set hero_eyebrow = component.eyebrow|default(trans('blocks.leen.hero_eyebrow')) %}
{% set hero_title = component.title|default(trans('blocks.leen.hero_title')) %}
{% set hero_description = component.description|default(trans('blocks.leen.hero_description')) %}
{% set hero_image = component.image|default('images/leen-editorial.jpg'|asset) %}
{% set hero_image_alt = component.image_alt|default(trans('blocks.leen.hero_image_alt')) %}
{% set hero_cta_label = component.cta_label|default(trans('blocks.leen.hero_cta')) %}
{% set hero_cta_url = component.cta_url|default(store.url) %}

<section component-id="{{ componentId }}" data-testid="store-home-leen-editorial-hero" class="s-block leen-hero">
    <div class="container">
        <div class="leen-hero__grid">
            <div class="leen-hero__copy">
                <p class="leen-hero__eyebrow"><span aria-hidden="true"></span>{{ hero_eyebrow }}</p>
                <h2 class="leen-hero__title">{{ hero_title }}</h2>
                {% if hero_description %}
                    <p class="leen-hero__description">{{ hero_description }}</p>
                {% endif %}
                <a class="leen-button" href="{{ hero_cta_url }}">
                    <span>{{ hero_cta_label }}</span>
                    <span class="leen-button__arrow" aria-hidden="true">↖</span>
                </a>
                <p class="leen-hero__footnote">{{ trans('blocks.leen.hero_note') }}</p>
            </div>

            <figure class="leen-hero__visual">
                <img
                    src="{{ hero_image }}"
                    alt="{{ hero_image_alt }}"
                    width="928"
                    height="1160"
                    fetchpriority="high"
                    loading="eager"
                >
                <figcaption class="leen-hero__caption">
                    <span>{{ trans('blocks.leen.hero_caption') }}</span>
                    <span aria-hidden="true">01 / 03</span>
                </figcaption>
                <span class="leen-hero__seal" aria-hidden="true">{{ trans('blocks.leen.hero_seal') }}</span>
            </figure>
        </div>
    </div>
</section>
