{#
| Variable                  | Type     | Description                                    |
|---------------------------|----------|------------------------------------------------|
| component                 | object   | Merchant-editable settings from twilight.json |
| component.eyebrow         | string   | Optional introductory label                    |
| component.title           | string   | Section heading                                |
| component.description     | string   | Supporting copy                                |
| component.items           | object[] | Three or four editable gift occasions          |
| componentId               | string   | Twilight component identifier                  |
#}
{% set occasions_eyebrow = component.eyebrow|default(trans('blocks.ward.occasions_eyebrow')) %}
{% set occasions_title = component.title|default(trans('blocks.ward.occasions_title')) %}
{% set occasions_description = component.description|default(trans('blocks.ward.occasions_description')) %}

<section component-id="{{ componentId }}" data-testid="store-home-ward-occasion-guide" class="s-block ward-occasions">
    <div class="container">
        <div class="ward-occasions__intro">
            <p class="ward-occasions__eyebrow">{{ occasions_eyebrow }}</p>
            <h2>{{ occasions_title }}</h2>
            {% if occasions_description %}
                <p>{{ occasions_description }}</p>
            {% endif %}
        </div>

        <div class="ward-occasions__layout">
            <figure class="ward-occasions__visual">
                <img src="{{ 'images/ward-story.jpg'|asset }}" alt="{{ trans('blocks.ward.occasions_image_alt') }}" width="1280" height="854" loading="lazy">
                <figcaption>{{ trans('blocks.ward.occasions_image_caption') }}</figcaption>
            </figure>
            <div class="ward-occasions__grid">
            {% for item in component.items %}
                {% if item.title or item.description %}
                    <article class="ward-occasion">
                        <span class="ward-occasion__index" aria-hidden="true">0{{ loop.index }}</span>
                        <h3>{{ item.title }}</h3>
                        {% if item.description %}
                            <p>{{ item.description }}</p>
                        {% endif %}
                        <span class="ward-occasion__mark" aria-hidden="true">✳</span>
                    </article>
                {% endif %}
            {% endfor %}
            </div>
        </div>
    </div>
</section>
