{% if component.items is not empty %}
<section component-id="{{ componentId }}" data-testid="store-home-custom-testimonials" class="s-block s-block--testimonials s-block--custom-testimonials container overflow-hidden">
	<div class="s-reviews-container">
		<div class="s-reviews-header-wrapper">
			<h2 class="s-reviews-header">{{ trans('blocks.home.testimonials') }}</h2>
		</div>
		<salla-slider id="custom-testimonials-{{ position }}-slider" slides-per-view="1" type="testimonials" class="testimonials-slider s-slider-wrapper" centered controls-outer aria-label="{{ trans('blocks.home.testimonials') }}">
			<div slot="items">
				{% for item in component.items %}
					{% if item.name or item.text or item.stars %}
						<div class="s-reviews-swiper-slide swiper-slide">
							<article class="s-reviews-testimonial">
								<div class="s-reviews-testimonial__inner">
									{% if item.avatar %}
										<div class="s-reviews-testimonial__avatar">
											<img src="{{ item.avatar }}" loading="lazy" decoding="async" alt="{{ item.name|trim }}" width="68" height="68">
										</div>
									{% endif %}
									<div class="s-reviews-testimonial__text">
										{% if item.text %}
											<p class="text-sm leading-6 text-gray-700">{{ item.text }}</p>
										{% endif %}
										{% if item.name or item.stars %}
											<div class="s-reviews-testimonial__name_wrapper items-center">
												<div class="s-reviews-testimonial__info">
													{% if item.name %}<h3 class="font-bold text-sm xs:text-base text-gray-900">{{ item.name }}</h3>{% endif %}
												</div>
												{% if item.stars %}
													<div class="s-reviews-testimonial__rating !mx-0">
														<salla-rating-stars class="flex" size="small" value="{{ item.stars }}"></salla-rating-stars>
													</div>
												{% endif %}
											</div>
										{% endif %}
									</div>
									<span class="s-reviews-testimonial__icon" aria-hidden="true">
										<svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
											<path d="M8 12v-5.333c0-0.737-0.596-1.333-1.333-1.333-3.676 0-6.667 2.991-6.667 6.667v8c0 3.676 2.991 6.667 6.667 6.667h1.333c3.676 0 6.667-2.991 6.667-6.667v-1.333c0-3.676-2.991-6.667-6.667-6.667zM12 20c0 2.205-1.795 4-4 4h-1.333c-2.205 0-4-1.795-4-4v-8c0-1.739 1.115-3.221 2.667-3.772v5.105c0 0.737 0.596 1.333 1.333 1.333h1.333c2.205 0 4 1.795 4 4zM25.333 12v-5.333c0-0.737-0.596-1.333-1.333-1.333-3.676 0-6.667 2.991-6.667 6.667v8c0 3.676 2.991 6.667 6.667 6.667h1.333c3.676 0 6.667-2.991 6.667-6.667v-1.333c0-3.676-2.991-6.667-6.667-6.667zM29.333 20c0 2.205-1.795 4-4 4h-1.333c-2.205 0-4-1.795-4-4v-8c0-1.739 1.115-3.221 2.667-3.772v5.105c0 0.737 0.596 1.333 1.333 1.333h1.333c2.205 0 4 1.795 4 4z"></path>
										</svg>
									</span>
								</div>
							</article>
						</div>
					{% endif %}
				{% endfor %}
			</div>
		</salla-slider>
	</div>
</section>
{% endif %}
